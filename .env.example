# Veritas Gate — environment configuration
#
# Copy to .env and fill in. Secrets live ONLY in the environment; veritas.yaml
# never contains an API key, only the name of the variable that holds one.
#
#   cp .env.example .env
#   set -a && . ./.env && set +a
#
# .env is git-ignored. Never commit it.

# ─── Provider credentials ────────────────────────────────────────────────────
# Set the key for each provider you actually use. A provider is only contacted
# if a judge in your veritas.yaml is routed to it.

# Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google (Gemini) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# OpenAI-compatible endpoint (vLLM, Ollama, LM Studio, Together, Groq, a
# gateway, or a local model). Used by provider: openai-compatible.
OPENAI_COMPATIBLE_API_KEY=
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1

# ─── Optional base URL overrides ─────────────────────────────────────────────
# Point a provider at a proxy, a regional endpoint or a gateway. Leave unset to
# use the vendor default. These are read by veritas.yaml via ${VAR:-default}.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ─── Model selection ─────────────────────────────────────────────────────────
# Model ids are never hard-coded in Veritas. Configure which model plays which
# role here, and veritas.yaml interpolates them. Any model id your provider
# accepts is valid; the values below are only a starting point.

VERITAS_DEFAULT_PROVIDER=anthropic
VERITAS_DEFAULT_MODEL=claude-sonnet-4-5

# The adversarial reviewer deliberately runs on a different vendor than the
# other judges, so a single model's blind spots do not decide the outcome.
VERITAS_ADVERSARIAL_PROVIDER=openai
VERITAS_ADVERSARIAL_MODEL=gpt-4.1

# The meta reviewer consolidates the other judges' results.
VERITAS_META_PROVIDER=google
VERITAS_META_MODEL=gemini-2.5-pro

# Per-judge overrides (optional). Any role named in veritas.yaml can be
# pointed at its own provider and model.
# VERITAS_METHODOLOGY_MODEL=
# VERITAS_EVIDENCE_MODEL=
# VERITAS_STATISTICS_MODEL=
# VERITAS_REPRODUCIBILITY_MODEL=
# VERITAS_CITATIONS_MODEL=
# VERITAS_REPO_CONSISTENCY_MODEL=

# ─── TLS ─────────────────────────────────────────────────────────────────────
# Behind a corporate proxy that intercepts TLS, requests fail with
# CERTIFICATE_VERIFY_FAILED. The fix is to trust your organisation's CA, which
# is already installed in your operating system's trust store. In veritas.yaml:
#
#   models:
#     default:
#       tls_verify: truststore        # pip install "veritas-gate[tls]"
#
# Or point at an explicit CA bundle, per model or for the whole process:
# SSL_CERT_FILE=/path/to/corporate-ca.pem
#
# `tls_verify: false` exists for a local endpoint with a self-signed
# certificate. Never use it against a provider on the internet: it exposes the
# API key above and the artifact being evaluated to anyone on the network path.

# ─── Profile discovery ───────────────────────────────────────────────────────
# Extra directories to search for profile plugins (os.pathsep-separated).
# VERITAS_PROFILE_PATH=/opt/veritas-profiles
