version: 1

profile: scientific-paper

artifact:
  type: document
  paths:
    - paper
    - experiments
    - results
    - scripts

# Model ids come from the environment so no vendor name is hard-coded here.
# Copy .env.example at the repository root and export the values.
models:
  default:
    provider: ${VERITAS_DEFAULT_PROVIDER:-anthropic}
    model: ${VERITAS_DEFAULT_MODEL:-claude-sonnet-5}
  adversarial:
    provider: ${VERITAS_ADVERSARIAL_PROVIDER:-openai}
    model: ${VERITAS_ADVERSARIAL_MODEL:-gpt-5.4-luna}
  meta:
    provider: ${VERITAS_META_PROVIDER:-google}
    model: ${VERITAS_META_MODEL:-gemini-3.57-pro}

gate:
  fail_on:
    - critical
  max_major: 0
  max_minor: 20

checks:
  repository-structure:
    type: required-paths
    enabled: true
    severity_on_failure: minor
    required_paths:
      - paper/main.md
      - results/benchmark.json

  required-sections:
    type: required-sections
    enabled: true
    target: paper/main.md
    severity_on_failure: major
    required_sections:
      - abstract
      - introduction
      - method
      - results
      - conclusion

# Nothing runs unless it is listed here.
execution:
  allow: []

# ─── Workspace ───────────────────────────────────────────────────────────────
# Where autopilot does its work. Your originals are never touched unless you
# choose `current`. Git is used when available and never required.
workspace:
  mode: worktree            # worktree | snapshot | copy | current
  include_untracked: true
  respect_gitignore: true
  respect_veritasignore: true

# ─── The bounded repair loop (`veritas loop`) ────────────────────────────────
# Every setting here exists to make the loop stop. There is no configuration
# that produces an unbounded loop.
loop:
  enabled: true
  max_iterations: 5
  consecutive_non_improving_iterations: 2
  same_blocker_repeated: 2
  stop_on_new_critical: true
  stop_on_regression: true
  max_changed_files: 25
  max_cost_usd: null

repair:
  mode: autopilot
  agent:
    # The agent is a worker driven by a command template. Placeholders:
    # {prompt_file} {plan_file} {result_file} {workspace}
    provider: generic-cli
    command:
      - codex
      - exec
      - "{prompt_file}"
    timeout: 1800

  # The line between true and false is the safety invariant: Veritas may
  # improve how existing evidence is represented, implemented, documented or
  # validated. It may not fabricate evidence that does not exist.
  permissions:
    documentation: true
    source_code: true
    tests: true
    experiments: false
    datasets: false
    scientific_claims: false
    methodology: false
    edit_files: true
    run_tests: false
    run_build: false
